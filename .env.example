# AI (create a key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Voice (create a key at https://elevenlabs.io/api-keys)
ELEVENLABS_API_KEY=
# Optional: pin a specific ElevenLabs voice id. Leave empty to auto-pick a British female voice.
ELEVENLABS_VOICE_ID=

# Gmail (enable 2FA and create an App Password at https://myaccount.google.com/apppasswords)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Audio (optional; leave as ints matching `python -c "import sounddevice as sd; print(sd.query_devices())"`)
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# Wake / listen tuning (optional)
WAKE_CLAP_MIN_COUNT=2
LISTEN_MAX_SEC=12.0
LISTEN_SILENCE_SEC=1.2

# Security / owner identity (per-installation)
# The person who sets up this machine is its owner. FRIDAY verifies them with
# voice biometrics (vosk-model-spk-0.4) and/or a spoken passphrase before
# briefing or accepting commands.
OWNER_NAME=Boss
SECURITY_ENABLED=False
# voice | passphrase | both
SECURITY_MODE=voice
# Spoken passphrase used in passphrase / both mode (also settable via enrollment)
SECURITY_PASSPHRASE=
# Cosine-similarity threshold for voice match (0.0-1.0; higher = stricter)
SPEAKER_THRESHOLD=0.72

# Application
APP_NAME=FRIDAY
APP_VERSION=0.1.0
DEBUG=True

# Logging
LOG_LEVEL=INFO